TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
ALLOWED_USER_IDS=your-telegram-chat-id-here
NEXT_JS_URL=http://localhost:3000
NODE_ENV=production

# ============================================================================
# LLM Bridge - Provider Configuration
# Priority order: copilot > openrouter > zen > direct
# ============================================================================

# OpenRouter (free models like Qwen)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ENABLED=true

# OpenCode Zen (free trials)
ZEN_API_KEY=
ZEN_MODEL=zen-default
ZEN_BASE_URL=https://zen.opencode.ai/v1
ZEN_ENABLED=true

# Direct API (any OpenAI-compatible provider)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_ENABLED=true

# GitHub Copilot (requires subscription)
COPILOT_TOKEN=
COPILOT_MODEL=gpt-4o
COPILOT_ENABLED=true

# Feature flag: set to false to use legacy opencode.js
LLM_BRIDGE_ENABLED=true

# ============================================================================
# OpenCode Headless — Phase 3: Telegram Migration
# ============================================================================

# Use OpenCode headless as the primary chat engine (default: true)
# Set to false to fall back to LLM Bridge or legacy tmux-based OpenCode
TELEGRAM_USE_OPENCODE=true

# Enable trace persistence to Next.js API for web UI visibility (default: true)
TRACE_PERSISTENCE_ENABLED=true

# OpenCode server port (default: 4153)
OPENCODE_PORT=4153

# Default project ID for sessions without explicit project context
# DEFAULT_PROJECT_ID=

# Default working directory for OpenCode (default: process.cwd())
# DEFAULT_DIRECTORY=/home/matias/devhub
