#!/usr/bin/env bash
# ponytail-mode — read/write the active ponytail rule mode.
# State file: ~/.config/opencode/.ponytail-active
# Valid modes: off | lite | full | ultra

set -euo pipefail

STATE_FILE="${HOME}/.config/opencode/.ponytail-active"

usage() {
  cat <<'EOF'
ponytail-mode — manage the active ponytail mode

Usage:
  ponytail-mode status
  ponytail-mode <off|lite|full|ultra>
  ponytail-mode sdd <phase>     apply a phase preset
  ponytail-mode reset           delete state (plugin falls back to default)
  ponytail-mode path            print the state file path

Phase presets (sdd):
  init, explore, propose, archive  -> off
  spec                              -> lite
  design, tasks, apply, verify     -> full
EOF
}

set_mode() {
  local mode="$1"
  case "$mode" in
    off|lite|full|ultra) printf '%s\n' "$mode" > "$STATE_FILE" ;;
    *) echo "invalid mode: $mode (expected: off|lite|full|ultra)" >&2; exit 2 ;;
  esac
  echo "ponytail mode -> $mode"
}

sdd_phase() {
  local phase="$1"
  case "$phase" in
    init|explore|propose|archive) set_mode off ;;
    spec)                         set_mode lite ;;
    design|tasks|apply|verify)    set_mode full ;;
    *) echo "unknown sdd phase: $phase" >&2; exit 2 ;;
  esac
}

cmd="${1:-status}"

case "$cmd" in
  status)
    if [[ -f "$STATE_FILE" ]]; then
      printf 'ponytail mode -> %s\n' "$(cat "$STATE_FILE")"
    else
      echo "ponytail mode -> (unset; plugin default applies)"
    fi
    ;;
  reset) rm -f "$STATE_FILE"; echo "ponytail mode reset (plugin default applies)" ;;
  path)  printf '%s\n' "$STATE_FILE" ;;
  sdd)   sdd_phase "${2:-}" ;;
  off|lite|full|ultra) set_mode "$cmd" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
