#!/usr/bin/env sh

while read local_ref local_sha remote_ref remote_sha
do
  if [ "$remote_ref" = "refs/heads/main" ] || [ "$remote_ref" = "refs/heads/master" ]; then
    echo ""
    echo "🚨 ERROR: push directo a rama protegida bloqueado ($remote_ref)."
    echo "Publicá la rama de tarea y seguí el path de PR/merge aprobado."
    exit 1
  fi
done

exit 0
