# DevHub Environment Variables (example)

# Copy this file to .env.local (or .env) and fill real values.
# NEVER commit real secrets. .env.local is gitignored.

# === Local mode (default, byte-identical, no auth wall) ===
# DEVHUB_OPERATION_MODE=local-dev
# DEVHUB_AUTH_PROVIDER=local
# DEVHUB_DB_DRIVER=sqlite

# === Cloud / Multi-tenant mode (devhub-cloud-foundation) ===
# Set these to activate the new system: AuthProvider port, tenancy policy,
# workspace context, 6 new workspace.* MCP tools, web invitation flow, RLS.
# When these are set, the MCP server and web app switch to multi-tenant.
# Rollback: comment them out or set back to local-dev/sqlite.

DEVHUB_OPERATION_MODE=cloud
DEVHUB_AUTH_PROVIDER=supabase
DEVHUB_DB_DRIVER=supabase

# Supabase (your existing MCP connection)
# Use the same project you already have connected for DevHub.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...   # preferred for server/MCP

# For future postgres-generic driver (thin pg, same surface as sqlite)
# DEVHUB_DB_DRIVER=postgres-generic
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require
# DATABASE_SSL=true

# Optional: pool size for pg driver
# DATABASE_POOL_SIZE=10

# Owner email used for seeding / local ownership
NEXT_PUBLIC_OWNER_EMAIL=matiastobarsilva12344321@gmail.com

# Other existing vars (SDD, etc.) remain untouched.
SDD_ENABLED=true
