  "scripts": {
    "native:ensure": "node scripts/ensure-native-runtime.cjs",
    "predev": "pnpm run native:ensure",
    "prebuild": "pnpm run native:ensure",
    "start": "pnpm exec next dev --port 3100",
    "dev": "pnpm exec next dev --port 3100",
    "build": "pnpm run native:ensure && pnpm exec next build && STANDALONE=.next/standalone; for d in opencode research data devhub-cli devhub-mcp devhub.db devhub.db-* docs logs sidecar-backend opencode.json '*.bak' tmp; do rm -rf \"$STANDALONE/$d\" 2>/dev/null || true; done; rm -rf \"$STANDALONE/.next/cache\" 2>/dev/null || true; rm -rf \"$STANDALONE/public\" 2>/dev/null || true; cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/ && cp -r src/lib .next/standalone/src/ && find .next/standalone/node_modules/@img -name \"*musl*\" -type d -prune -exec rm -rf {} + 2>/dev/null; find .next/standalone/node_modules/@img -name \"*-musl*\" -type f -delete 2>/dev/null; rm -rf .next/standalone/src-tauri .next/standalone/.next/cache .next/standalone/node_modules/@img/sharp*-linuxmusl* && cp -rL sidecar-backend/node_modules/node-pty .next/standalone/node_modules/node-pty && cp -r node_modules/ws .next/standalone/node_modules/ && rm -rf .next/standalone/node_modules/@swc/helpers && cp -rL node_modules/@swc/helpers .next/standalone/node_modules/@swc/helpers && mkdir -p src-tauri/resources && rm -f src-tauri/resources/standalone.zip && cd .next/standalone && zip -q -ry ../../src-tauri/resources/standalone.zip .",
    "tauri": "node scripts/tauri-cli.cjs",
    "tauri:dev": "node scripts/tauri-cli.cjs dev",
    "tauri:build": "pnpm run generate-icon && node scripts/tauri-cli.cjs build",
    "native:vte-smoke": "node scripts/native-vte-smoke.cjs",
    "qa:multi-agent-desktop": "node scripts/qa/run-multi-agent-desktop.cjs",
    "generate-icon": "node scripts/generate-preview.js && node scripts/generate-icon.js && pnpm exec tauri icon public/logo-square.png -o src-tauri/icons",
    "agenthub-test": "node bin/agenthub-test.js",
    "agenthub-smoke": "node bin/agenthub-smoke.js",
    "test": "pnpm exec jest --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx --max-warnings 30",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,css}'",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings 200 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
