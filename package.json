  "scripts": {
    "native:ensure": "node scripts/ensure-native-runtime.cjs",
    "voice:ensure": "node scripts/ensure-voice-runtime.cjs",
    "voice:add-voice": "node scripts/voice-add-voice.cjs",
    "predev": "npm run native:ensure && npm run voice:ensure",
    "prebuild": "npm run native:ensure && npm run voice:ensure",
    "start": "node scripts/next-dev.cjs",
    "dev": "node scripts/next-dev.cjs",
    "build": "next build && node scripts/build-standalone-zip.cjs",
    "build:sidecar": "node scripts/build-devhub-server-sidecar.cjs",
    "build:sidecar-detection": "node scripts/build-sidecar-agent-detection.mjs",
    "tauri": "node scripts/tauri-cli.cjs",
    "tauri:dev": "node scripts/tauri-dev.cjs",
    "tauri:build": "node scripts/generate-icon-if-needed.cjs && npm run build:sidecar && node scripts/tauri-cli.cjs build",
    "qa:multi-agent-desktop": "node scripts/qa/run-multi-agent-desktop.cjs",
    "generate-icon": "node scripts/generate-preview.js && node scripts/generate-icon.js && npx @tauri-apps/cli icon public/logo-square.png -o src-tauri/icons",
    "agenthub-test": "node bin/agenthub-test.js",
    "agenthub-smoke": "node bin/agenthub-smoke.js",
    "test": "node ./node_modules/jest/bin/jest.js --runInBand",
    "benchmark:zed-models": "node scripts/benchmark-zed-models.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx --max-warnings 30",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,css}'",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings 500 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "optionalDependencies": {
    "pg": "^8.8"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
