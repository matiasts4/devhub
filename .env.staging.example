# Staging deploy — enable pizarra shared-view (Phase B.1b)
# Copy to .env.production.local or inject in CI/CD for staging only.
# Production default remains OFF until manual .deb QA + A.0 metrics are green.

NEXT_PUBLIC_PIZARRA_SHARED_VIEW_STATE=1

# Optional: force staging rollout stage detection (getRolloutStage() === 'staging'
# when NODE_ENV=production and this var is set explicitly).
