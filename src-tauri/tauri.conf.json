{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DevHub",
  "version": "0.1.1",
  "identifier": "com.devhub.desktop",
  "build": {
    "frontendDist": "http://127.0.0.1:3400",
    "devUrl": "http://127.0.0.1:3100",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "DevHub — Autonomous Dev Workspace",
        "width": 1680,
        "height": 1040,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "targets": ["deb", "appimage", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../sidecar-backend", "resources/standalone.zip"],
    "externalBin": ["binaries/devhub-server"],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "files": {
          "../packaging/linux/devhub-launcher": "/usr/lib/DevHub/bin/devhub-launcher",
          "../packaging/linux/DevHub.desktop": "/usr/share/applications/DevHub.desktop"
        }
      }
    }
  }
}
