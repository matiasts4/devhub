{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DevHub",
  "version": "0.1.1",
  "identifier": "com.devhub.desktop",
  "build": {
    "frontendDist": "http://127.0.0.1:3400",
    "devUrl": "http://127.0.0.1:3100",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "DevHub — Autonomous Dev Workspace",
        "width": 1680,
        "height": 1040,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "targets": ["deb", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar-backend": "sidecar-backend",
      "../packaging/devhub-server.cjs": "devhub-server.cjs",
      "resources/standalone.zip": "standalone.zip",
      "../packages/veloce-audio/python/requirements.txt": "veloce-audio/requirements.txt",
      "../packages/veloce-audio/python/voices/**/*": "veloce-audio/voices/"
    },
    "externalBin": ["binaries/devhub-server"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "unzip",
          "python3-venv",
          "libportaudio2"
        ],
        "postInstallScript": "../packaging/linux/postinst",
        "files": {
          "/usr/share/applications/DevHub.desktop": "../packaging/linux/DevHub.desktop",
          "/usr/lib/DevHub/bin/devhub-launcher": "../packaging/linux/devhub-launcher"
        }
      }
    }
  }
}
