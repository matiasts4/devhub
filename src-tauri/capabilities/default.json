{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de DevHub: shell (sidecar), ventana, tray",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:tray:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-kill",
    "shell:allow-open",
    "log:default"
  ]
}
